[resource]
script = ExtResource("1_script")
id = &"oxygen_tank"
display_name = "Tanques de oxígeno"
display_name_en = "Oxygen tanks"
description = "Guardan oxígeno de reserva y lo sueltan cada día. MOXIE, en Perseverance, sacó 122 g de oxígeno del aire de Marte. Sus bombas usan algo de energía."
