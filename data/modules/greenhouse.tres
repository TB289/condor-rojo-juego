[resource]
script = ExtResource("1_script")
id = &"greenhouse"
display_name = "Invernadero"
display_name_en = "Greenhouse"
description = "Aquí crecen plantas: te dan comida, un poquito de oxígeno y limpian el dióxido de carbono que exhalas. Necesitan luz y calor, así que gasta mucha energía."
description_en = "Plants grow here: they give you food, a little oxygen, and they clean the carbon dioxide you breathe out. They need light and heat, so it uses a lot of energy."
